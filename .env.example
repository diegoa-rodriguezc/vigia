# ╔═══════════════════════════════════════════════════════════╗
# ║ VigIA — variables de entorno (copiar a .env)              ║
# ╚═══════════════════════════════════════════════════════════╝

# Copiar este archivo a `.env` (`cp .env.example .env`) y ajusta los valores.
# Los valores por defecto funcionan tal cual para el despliegue con Docker (`make deploy`).

# OJO: los hostnames `db`, `ollama`, `ml`, `redis` son nombres de la red interna de Docker
# Compose; SOLO resuelven entre contenedores. Para correr una capa en local (fuera de Docker),
# reemplazarlos por `localhost`.

# ------------------------------------------------------------------------------
# =============================================================
# Base de datos (PostgreSQL + pgvector)
# =============================================================
# Credenciales y nombre de la base. Postgres se crea con estos valores la primera vez que arranca
# su volumen; el mismo `vigia` guarda los datos gold y el índice del RAG (extensión pgvector).
POSTGRES_USER=vigia
POSTGRES_PASSWORD=vigia_dev_password
POSTGRES_DB=vigia
# Host y puerto DENTRO de la red Docker (`db`). En local sería `localhost`.
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Cadena de conexión completa (la usan el backend Go y el servicio ML). Debe coincidir con los
# valores de arriba. `sslmode=disable` está bien en local/Docker; en producción usa SSL.
DATABASE_URL=postgres://vigia:vigia_dev_password@db:5432/vigia?sslmode=disable

# ------------------------------------------------------------------------------
# =============================================================
# Servicio ML (Python / FastAPI) — el núcleo de IA (ETL + modelo + RAG)
# =============================================================
# Dirección y puerto donde escucha FastAPI dentro del contenedor. 0.0.0.0 = todas las interfaces.
ML_API_HOST=0.0.0.0
ML_API_PORT=8000
# URL con la que el backend Go llama al servicio ML (proxy de IA). Hostname de la red Docker.
ML_API_URL=http://ml:8000

# ------------------------------------------------------------------------------
# =============================================================
# Backend (Go) — API REST que consume el frontend
# =============================================================
BACKEND_PORT=8080
# Orígenes permitidos para CORS (desde dónde puede llamar el navegador). Es el host del frontend;
# si lo sirves en otro dominio/puerto, añadirlo aquí (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Entorno: development | production. En production se exige un JWT_SECRET fuerte (fail-closed).
APP_ENV=development

# ------------------------------------------------------------------------------
# =============================================================
# Autenticación (JWT + Redis)
# =============================================================
# Lectura de datos abiertos: pública (con rate-limit). Pronóstico y asistente: requieren login.
# Conexión a Redis (sesiones, caché y rate-limit). Hostname de la red Docker.
REDIS_URL=redis://redis:6379/0
# Secreto de firma de los JWT. CÁMBIALO por un valor largo y aleatorio en producción, p. ej.:
#   openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Vigencia del token de acceso (corto) y del de refresco (largo). Formato Go: 15m, 48h, 7d…
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=48h

# Usuario administrador insertado al arrancar el backend. CAMBIAR la contraseña en producción.
# La contraseña debe cumplir la política (≥12 chars, mayúscula, minúscula, dígito y símbolo);
# si APP_ENV=production una contraseña débil ABORTA el arranque (fail-closed).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Demo.VigIA.2026
# Confianza en cabeceras de proxy (X-Forwarded-For/X-Real-IP) para deducir la IP del cliente.
# Dejarlo en false salvo que el backend esté tras un proxy inverso de confianza; si no, las
# cabeceras son falsificables y permitirían evadir el rate-limit y el lockout de login.
TRUST_PROXY_HEADERS=false
# Rate limiting (peticiones por minuto y por IP): tráfico público general y endpoint de login.
RATE_LIMIT_PUBLIC=120
RATE_LIMIT_LOGIN=10

# ------------------------------------------------------------------------------
# =============================================================
# Caché de respuestas de IA (Redis)
# =============================================================
# Sirve respuestas repetidas de /forecast y /assistant en ms en vez de recalcular en el
# LLM/modelo (lento en CPU). Usa ?nocache=1 en la petición para forzar el recálculo.
CACHE_ENABLED=true
# Cuánto se conserva cada respuesta cacheada antes de recalcular (TTL). Formato Go: 6h, 30m…
# Tras reentrenar el modelo, un pronóstico puede servirse cacheado hasta que venza este TTL.
CACHE_FORECAST_TTL=6h
CACHE_ASSISTANT_TTL=1h

# ------------------------------------------------------------------------------
# =============================================================
# Frontend (React)
# =============================================================
# URL base de la API del backend Go que el navegador llama. Es una URL pública (la ve el cliente),
# por eso apunta a localhost:8080 y no al hostname interno de Docker.
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# =============================================================
# Ingesta de datos abiertos (SODA2)
# =============================================================
# Token de aplicación de datos.gov.co (opcional). Sin él funciona, pero con cuotas/límites más
# bajos; un token sube el límite de peticiones. Déjalo vacío si no tienes uno.
SODA_APP_TOKEN=
# Tope de filas a descargar por dataset (opcional, para pruebas rápidas). Vacío = sin límite.
SODA_MAX_ROWS=

# ------------------------------------------------------------------------------
# =============================================================
# Proveedor de LLM para el RAG (el asistente conversacional)
# =============================================================
# Quién GENERA el texto de la respuesta del asistente: ollama (local, por defecto) | anthropic | openai.
# Con `ollama` todo corre en la máquina (gratis, privado, lento en CPU); anthropic/openai son de
# pago, en la nube y mucho más rápidos (requieren su API key más abajo).
LLM_PROVIDER=ollama
# URL del servidor Ollama (LLM + embeddings locales). Hostname de la red Docker.
OLLAMA_BASE_URL=http://ollama:11434

# Modelo de lenguaje (LLM) que redacta la respuesta. Debe estar descargado en Ollama
# (`make ollama-pull` o `ollama pull <tag>`). En CPU el techo práctico es ~1.5-2B parámetros.
OLLAMA_LLM_MODEL=qwen3:1.7b
# Modelo de EMBEDDINGS de Ollama: convierte texto a vectores para la búsqueda por similitud del RAG.
# Es distinto del LLM. Cambiarlo altera la dimensión del vector → hay que re-indexar (rag-index).
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
# Razonamiento "thinking" (qwen3, deepseek-r1…). Dejarlo en false en CPU: si no, el modelo agota
# el presupuesto de tokens pensando y la respuesta sale en blanco (con fuentes, pero sin texto).
OLLAMA_THINK=false
# Temperatura del modelo/respuesta, valor entre 0 y 1.
# Un número bajo el modelo genera respuestas deterministas, conservadoras y repetibles,
# un número alto, (>=0.6), genera respuestas más variadas y creativas, pero con
# más riesgo de divagar o inventar.
OLLAMA_TEMPERATURE=0.2
# Tope de tokens generados: en CPU acota la latencia. Subirlo puede reventar el muro de timeouts
# (~240s) y, con modelos "thinking", agotarse pensando. No subir en CPU sin reemplazar el modelo.
OLLAMA_NUM_PREDICT=220
# Ventana de contexto (más RAM). La comparten el LLM y el embedder (deben coincidir); el embedder
# la usa como batch: bajarla de ~2048 puede dar 500 en chunks largos.
OLLAMA_NUM_CTX=2048
# Tiempo que Ollama mantiene cada modelo residente entre consultas (anti-thrashing). Lo envían LLM
# y embedder por request; mantenerlos a ambos residentes evita recargas frías (503 intermitente).
OLLAMA_KEEP_ALIVE=30m

# == Proveedor de EMBEDDINGS (búsqueda semántica del RAG) ==
# Quién convierte el texto en vectores. Es INDEPENDIENTE de LLM_PROVIDER: se puede combinar (p. ej.
# embeddings locales + LLM en la nube). Valores: ollama | local | openai.
#   - ollama → usa OLLAMA_EMBED_MODEL (servidor Ollama; por defecto).
#   - local  → usa LOCAL_EMBED_MODEL: corre dentro del proceso Python con sentence-transformers,
#              SIN Ollama (requiere instalar el extra `rag-local`: pip install -e ".[rag-local]").
#   - openai → usa OPENAI_EMBED_MODEL (de pago, en la nube; requiere OPENAI_API_KEY).
# IMPORTANTE: el índice (kb_chunks) se construye con el embedder elegido. Si lo cambias, debes
# re-indexar (`make docker-rag-index`), porque los vectores guardados no son compatibles entre modelos.
EMBED_PROVIDER=ollama
# Modelo de sentence-transformers (nombre en HuggingFace) usado SOLO cuando EMBED_PROVIDER=local.
# Multilingüe, pensado para español. Se descarga la primera vez. Si usas ollama/openai, se ignora.
LOCAL_EMBED_MODEL=intfloat/multilingual-e5-base

# == Proveedor en la nube: Anthropic (Claude) ==
# Solo se usa si LLM_PROVIDER=anthropic. Pega tu API key y elige el modelo. Más rápido que Ollama
# local, pero de pago y los datos salen a la nube.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# == Proveedor en la nube: OpenAI ==
# Solo se usa si LLM_PROVIDER=openai (LLM) y/o EMBED_PROVIDER=openai (embeddings).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# == Calibración del RAG ==
# Umbral del guardarraíl anti-alucinación del RAG: similitud mínima [0-1] para que un fragmento
# recuperado se considere relevante. Si ninguno lo alcanza (y no hay pronóstico), el asistente
# rehúsa en vez de inventar. Súbelo para ser más estricto; bájalo para responder más.
RAG_MIN_SCORE=0.25

# Nº de fragmentos recuperados por consulta. Más k = más cobertura pero prompt más largo → LLM más
# lento en CPU (y más ruido para el guardarraíl de RAG_MIN_SCORE).
RAG_TOP_K=5

# ------------------------------------------------------------------------------
# =============================================================
# Reproducibilidad
# =============================================================
# Semilla global: fija la aleatoriedad del entrenamiento del modelo para que los resultados sean
# reproducibles entre corridas.
SEED=77
